# Copy this file to .env and replace every placeholder before running the app.
# Do not commit the resulting .env file.

# Use this value for local runs. Docker Compose supplies its own service hostname.
DATABASE_URL=postgresql://postgres:change-this-password@localhost:5432/text_to_sql_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=text_to_sql_db

# Obtain this from your Groq account.
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Comma-separated browser origins allowed to call the API in deployed environments.
ALLOWED_ORIGINS=http://localhost:8501

# The Streamlit container uses http://api:8000; use localhost when running it directly.
API_BASE_URL=http://localhost:8000
